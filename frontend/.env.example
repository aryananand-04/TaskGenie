# TaskGenie web app — environment variables
# Copy this file to `.env.local` and fill in at least one model key.
#
# The API route tries Groq first, then falls back to Gemini.
# Groq (primary)  — free key: https://console.groq.com/keys
# Gemini (fallback + embeddings) — free key: https://aistudio.google.com/apikey
GROQ_API_KEY=your_key_here
GEMINI_API_KEY=your_key_here

# GitHub Personal Access Token (classic, `repo` scope) — used to read repos for
# RAG and to create issues. https://github.com/settings/tokens
GITHUB_TOKEN=your_key_here

# Upstash Vector (optional — persistent vector store. Without these, the app
# falls back to an in-memory index that resets on restart.)
# Create a FREE index at https://console.upstash.com/vector with:
#   Dimensions = 768   (matches Gemini text-embedding-004)
#   Metric     = COSINE
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
