# TaskGenie — environment variables (Python CLI)
# Copy this file to `.env` and fill in at least one key.
#
# The CLI tries Groq first, then falls back to Gemini.
# Free Groq key (primary):    https://console.groq.com/keys
# Free Gemini key (fallback): https://aistudio.google.com/apikey
GROQ_API_KEY=your_key_here
GEMINI_API_KEY=your_key_here
